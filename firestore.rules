rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me(uid) { return signedIn() && request.auth.uid == uid; }
    function isModerator() {
      return signedIn() && exists(/databases/$(database)/documents/moderators/$(request.auth.uid));
    }
    function isDeveloper() {
      return signedIn() && exists(/databases/$(database)/documents/developers/$(request.auth.uid));
    }
    function validText(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }
    function areFriends(a, b) {
      return exists(/databases/$(database)/documents/friendships/$(a + '__' + b))
        || exists(/databases/$(database)/documents/friendships/$(b + '__' + a));
    }

    // Public directory/profile. XP and progression fields are server-managed.
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create: if me(uid)
        && request.resource.data.keys().hasOnly([
          'profileId','accountId','displayName','avatarColor','photo','title','frame',
          'xp','level','streak','bestStreak','tasksCompleted','focusMinutes','raceWins',
          'challengeWins','firstCompletionDate','firstCompletionAt','badgesCount',
          'updatedAt','public','online','lastSeen'
        ])
        && (!('xp' in request.resource.data) || request.resource.data.xp == 0)
        && (!('level' in request.resource.data) || request.resource.data.level == 1);
      allow update: if me(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName','avatarColor','photo','title','frame','updatedAt','public','online','lastSeen'
        ]);
      allow delete: if false;
    }

    // Presence is writable only by the signed-in user who owns the document.
    match /presence/{uid} {
      allow read: if signedIn();
      allow create, update: if me(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid','online','lastSeen'])
        && request.resource.data.online is bool;
      allow delete: if false;
    }

    // Friend requests use {fromUid}__{toUid} document IDs.
    match /friendRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && requestId == request.auth.uid + '__' + request.resource.data.to
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['from','to','fromName','status','createdAt']);
      allow update: if signedIn()
        && resource.data.to == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.from == resource.data.from
        && request.resource.data.to == resource.data.to
        && request.resource.data.status in ['accepted','declined']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','acceptedAt','updatedAt']);
      allow delete: if false;
    }

    // Friendship creation is performed by client transaction when accepting a request.
    // Membership is verified against the accepted request. IDs may be sorted by the app.
    match /friendships/{friendshipId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.closeFriends is list
        && request.resource.data.closeFriends.size() == 0
        && request.resource.data.keys().hasOnly(['members','closeFriends','createdAt','updatedAt'])
        && (
          getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.members[0] + '__' + request.resource.data.members[1])).data.status == 'accepted'
          || getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.members[1] + '__' + request.resource.data.members[0])).data.status == 'accepted'
        );
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['closeFriends','updatedAt'])
        && request.resource.data.closeFriends is list
        && request.resource.data.closeFriends.size() <= 2
        && (request.resource.data.closeFriends.size() == 0
          || request.resource.data.closeFriends[0] in resource.data.members)
        && (request.resource.data.closeFriends.size() < 2
          || request.resource.data.closeFriends[1] in resource.data.members);
      allow delete: if false;
    }

    // Private messages: only the two IDs embedded in the chat ID may access.
    // The app constructs chat IDs as sortedUidA__sortedUidB.
    match /chats/{chatId}/messages/{messageId} {
      allow read: if signedIn()
        && (chatId.matches('^' + request.auth.uid + '__.*$')
          || chatId.matches('^.*__' + request.auth.uid + '$'));
      allow create: if signedIn()
        && (chatId.matches('^' + request.auth.uid + '__.*$')
          || chatId.matches('^.*__' + request.auth.uid + '$'))
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && validText(request.resource.data.text, 2000)
        && request.resource.data.keys().hasOnly(['from','to','text','createdAt','senderName']);
      allow update, delete: if false;
    }

    // Team chat. Team documents must contain memberIds: [uid, ...].
    match /teams/{teamId} {
      allow read: if signedIn() && resource.data.memberIds is list
        && request.auth.uid in resource.data.memberIds;
      allow create, update, delete: if false;
      match /messages/{messageId} {
        function isTeamMember() {
          return signedIn()
            && get(/databases/$(database)/documents/teams/$(teamId)).data.memberIds is list
            && request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.memberIds;
        }
        allow read: if isTeamMember();
        allow create: if isTeamMember()
          && request.resource.data.from == request.auth.uid
          && validText(request.resource.data.text, 2000)
          && request.resource.data.keys().hasOnly(['from','text','senderName','createdAt']);
        allow update, delete: if false;
      }
    }

    // User-owned private data. On updates, the app cannot change progression fields
    // inside state.game; initial creation is restricted until server-side migration.
    match /users/{uid} {
      allow read: if me(uid);
      allow create, update: if me(uid);
      allow delete: if false;
      match /data/{docId} {
        allow read: if me(uid);
        allow create: if me(uid)
          && docId == 'main'
          && request.resource.data.state is map
          && request.resource.data.state.game is map
          && request.resource.data.state.game.xp == 0
          && request.resource.data.state.game.level == 1;
        allow update: if me(uid)
          && docId == 'main'
          && request.resource.data.state.game.xp == resource.data.state.game.xp
          && request.resource.data.state.game.level == resource.data.state.game.level;
        allow delete: if false;
      }
    }

    // XP ledger: users may read their own authoritative stats; only Admin SDK writes.
    match /userStats/{uid} {
      allow read: if me(uid);
      allow create, update, delete: if false;
      match /rewardEvents/{eventId} {
        allow read: if me(uid);
        allow create, update, delete: if false;
      }
    }

    // Administrative/security collections are never client-writable.
    match /bannedUsers/{uid} {
      allow read: if isDeveloper();
      allow write: if false;
    }
    match /moderators/{uid} {
      allow read: if isDeveloper() || me(uid);
      allow write: if false;
    }
    match /developers/{uid} {
      allow read: if me(uid);
      allow write: if false;
    }
    match /developer/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /gameCatalog/{type}/items/{itemId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Deny anything not explicitly permitted above. Add rules for the app's other
    // collections only after confirming their data model and authorization needs.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
